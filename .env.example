# ----------------------------------------------------------------------------
# Global AI-Assisted Job Portal — Phase 1A environment template
# Copy to .env and fill in. NEVER commit a real .env.
# ----------------------------------------------------------------------------

# --- Application ---
APP_NAME="Job Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Configurable brand name (do NOT hard-code brand in source; read from config/jobportal.php)
JOBPORTAL_BRAND_NAME="Global Career Connect"
JOBPORTAL_DEFAULT_COUNTRY=KW
JOBPORTAL_DEFAULT_CURRENCY=KWD

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (MariaDB) ---
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=jobportal
DB_USERNAME=jobportal
DB_PASSWORD=secret

# --- Sessions / Cache / Queue ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Mail (placeholder — Mailpit in dev) ---
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@jobportal.test"
MAIL_FROM_NAME="${JOBPORTAL_BRAND_NAME}"

# --- Filesystem / Object storage (placeholders, not active in 1A) ---
FILESYSTEM_DISK=local
# S3-compatible object storage for future media — leave blank in Phase 1A
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Backup storage (placeholder) ---
BACKUP_DISK=local
BACKUP_RETENTION_DAYS=14

# --- Security ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=60
LOGIN_ACTIVITY_RETENTION_DAYS=90
ADMIN_2FA_REQUIRED=true

# --- Super-admin bootstrap (used ONLY by SuperAdminSeeder; never hard-coded) ---
SUPER_ADMIN_NAME="Platform Owner"
SUPER_ADMIN_EMAIL=
# If left blank, the seeder generates a one-time secure password and prints it once.
SUPER_ADMIN_PASSWORD=

# --- Monitoring (placeholders) ---
HEALTH_DISK_THRESHOLD_PERCENT=90

# --- AI provider placeholders (NO active key required in Phase 1A) ---
# All AI features are globally disabled at this phase. These exist only so the
# AI Gateway phase can adopt them later. Do not store real secrets here yet.
AI_ENABLED=false
AI_EMBEDDINGS_ENABLED=false
AI_GENERATIVE_ENABLED=false
AI_ACTIVE_PROVIDER=none
AI_DAILY_BUDGET=0
AI_MONTHLY_BUDGET=0
AI_LOG_RETENTION_DAYS=30
AI_LOG_SENSITIVE_CONTENT=false

# --- Vite ---
VITE_APP_NAME="${JOBPORTAL_BRAND_NAME}"
