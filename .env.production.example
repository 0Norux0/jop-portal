# ----------------------------------------------------------------------------
# ICSA Jobs production environment template
# Copy values into the hosted server's real .env file. Do not upload this file
# as the active .env without changing APP_KEY, database, mail, and passwords.
# ----------------------------------------------------------------------------

APP_NAME="ICSA Jobs"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://icsajobs.com
APP_TIMEZONE=Asia/Kuwait
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

JOBPORTAL_BRAND_NAME="ICSA Jobs"
JOBPORTAL_DEFAULT_COUNTRY=KW
JOBPORTAL_DEFAULT_CURRENCY=KWD

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@icsajobs.com"
MAIL_FROM_NAME="${JOBPORTAL_BRAND_NAME}"

FILESYSTEM_DISK=local
FILESYSTEM_LOCAL_SERVE=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

BACKUP_DISK=local
BACKUP_RETENTION_DAYS=14

LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=60
LOGIN_ACTIVITY_RETENTION_DAYS=90
ADMIN_2FA_REQUIRED=true

SUPER_ADMIN_NAME="Platform Owner"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
DEMO_ACCOUNT_PASSWORD=

HEALTH_DISK_THRESHOLD_PERCENT=90

AI_ENABLED=false
AI_EMBEDDINGS_ENABLED=false
AI_GENERATIVE_ENABLED=false
AI_ACTIVE_PROVIDER=none
AI_DAILY_BUDGET=0
AI_MONTHLY_BUDGET=0
AI_LOG_RETENTION_DAYS=30
AI_LOG_SENSITIVE_CONTENT=false

VITE_APP_NAME="${JOBPORTAL_BRAND_NAME}"
